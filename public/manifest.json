{
  "manifest_version": 3,
  "name": "TaxTracker",
  "version": "1.0.0",
  "description": "Track tax deductions, mileage, and expenses for Australian taxpayers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TaxTracker",
    "default_popup": "popup.html"
  },
  "permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
